; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text for version control.

[application]

config/name="Godot Astronomy"
config/description="Precise astronomical calculations for Godot 4 — sun, moon, coordinates, and more."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.4")

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_astronomy/plugin.cfg")
