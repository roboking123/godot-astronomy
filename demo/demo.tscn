[gd_scene load_steps=2 format=3 uid="uid://demo001"]

[ext_resource type="Script" path="res://demo/demo.gd" id="1_demo"]

[node name="Demo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2

[node name="Controls" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="LatLabel" type="Label" parent="MarginContainer/VBox/Controls"]
layout_mode = 2
text = "Latitude:"

[node name="LatInput" type="SpinBox" parent="MarginContainer/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
min_value = -90.0
max_value = 90.0
step = 0.001
value = 25.033

[node name="LonLabel" type="Label" parent="MarginContainer/VBox/Controls"]
layout_mode = 2
text = "Longitude:"

[node name="LonInput" type="SpinBox" parent="MarginContainer/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
min_value = -180.0
max_value = 180.0
step = 0.001
value = 121.565

[node name="UseSystemTime" type="CheckBox" parent="MarginContainer/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Live Update"

[node name="UpdateButton" type="Button" parent="MarginContainer/VBox/Controls"]
layout_mode = 2
text = "Refresh"

[node name="OutputLabel" type="RichTextLabel" parent="MarginContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "Loading..."

[connection signal="pressed" from="MarginContainer/VBox/Controls/UpdateButton" to="." method="_on_update_button_pressed"]
